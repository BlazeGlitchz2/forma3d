# Forma3D Studio Configuration

# Studio Admin Email (Used for admin role verification)
STUDIO_ADMIN_EMAIL=owner@forma3d.studio

# Optional AI providers. Availability, models, quotas and pricing depend on the provider.
# Option 1: Groq
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=

# Option 2: OpenRouter
# Get free key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Option 3: Google Gemini
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 4: Direct DeepSeek API (model: deepseek-chat)
# Get key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: Override provider ('groq' | 'openrouter' | 'gemini' | 'deepseek') and model name
AI_PROVIDER=
AI_MODEL=

# Slicer Engine (Optional)
SLICER_URL=
SLICER_TOKEN=
SLICER_PROFILE_REVISION=
